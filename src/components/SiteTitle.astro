---
// @ts-ignore - Vite virtual module generated by Starlight at build time
import { logos } from 'virtual:starlight/user-images';
// @ts-ignore - Vite virtual module generated by Starlight at build time
import config from 'virtual:starlight/user-config';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title display-flex flex-align-center text-no-wrap" translate="no">
	{
		config.logo && (
			<>
				<img
					class="site-logo"
					alt={config.logo.alt}
					src={logos.light.src}
				/>
			</>
		)
	}
	<div class="display-flex flex-column">
		<span class="site-name text-heavy">
			{siteTitle}
		</span>
		<span class="site-tagline text-semibold">Garden State Design System</span>
	</div>
</a>

<style>
	@layer starlight.core {
		.site-logo {
			width: var(--grove-logo-width);
			height: auto;
		}
		.site-title {
			gap: var(--sl-nav-gap);
			color: var(--grove-logo-text-color);
			min-width: 0;
		}
		
		.site-name {
			font-size: var(--grove-logo-text-size);
			line-height: 1em;
		}
		.site-tagline {
			font-size: var(--grove-logo-tagline-size);
			line-height: 1.45em;
		}
	}
</style>
