---
interface Props {
  storybookUrl: string;
}

const { storybookUrl } = Astro.props;
---

<a class="usa-button usa-button--outline grove-button-outline margin-top-205" href={storybookUrl}>
    <svg class="usa-icon minw-3 minh-3" aria-hidden="true" focusable="false" role="img">
        <use href={`/assets/img/sprite.svg#code`} />
    </svg>
    View in Storybook
</a>