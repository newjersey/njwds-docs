---
import FigmaStorybookButtonGroup from '../components/FigmaStorybookButtonGroup.astro';
interface Props {
  name: string;
  description?: string;
}

const { name, description } = Astro.props;
---
<section>
    <div class="padding-top-6 padding-bottom-205 tablet:display-flex">
        <div class="flex-fill tablet:margin-right-2">
            <header>
                <span class="font-body-xs text-base">COMPONENT</span>
                <h1 class="margin-0">{name}</h1>
            </header>
            {Astro.slots.has('description') ? <slot name="description" /> : <p>{description}</p>}
            <div class="width-fit-content">
                <span class="padding-1 text-white wcag-badge">WCAG 2.1 AA</span>
            </div>
        </div>
        <div class="display-flex flex-align-start">
            <FigmaStorybookButtonGroup storybookUrl="https://njwds-sandbox.netlify.app/?path=/story/components-accordion--default" figmaUrl="https://www.figma.com/design/z8CI77qQvbffkCslHANatK/Grove--Garden-State-Design-System?node-id=1519-637&p=f&t=kIkWUxaAUytHfoIV-0"/>
        </div>
    </div>
</section>

<style>
    .wcag-badge {
        background-color: var(--grove-primary-600);
    } 
</style> 