---
import heroimage from '../assets/GroveHeroImage.png';
---
<section class="usa-hero display-flex grove-hero" aria-label="Introduction">
  <div class="usa-hero__callout margin-3 padding-y-4 padding-x-0 tablet:padding-10 tablet:margin-0 grove-hero-callout">
    <h1 id="_top" tabindex="-1" class="usa-hero__heading text-semibold font-heading-2xl grove-hero-h1">
      <span class="usa-hero__heading--alt grove-hero-primary-color">Designed to serve.</span>
      <span class="text-green">Built to grow.</span>
    </h1>
    <p class="text-ink tablet:font-body-lg">A design system from the New Jersey Innovation Authority that is helping teams build and scale accessible digital services.</p>
    <a class="usa-button grove-button" href="/guides/gettingstarted/">Get started</a>
  </div>
  <div class="display-none tablet:display-block grove-hero_image">
    <img class="height-full width-full" src={heroimage.src} alt="grid with various plant-inspired symbols representing innovation and design" />
  </div>
</section>

<style>
  .grove-hero {
    --grove-hero-callout-width: 42.5rem;
    position: relative;
    margin: auto;
    max-width: 87.5rem;
    background-image: var(--grove-hero-bg);
    @media (min-width: 42.5rem) {
      background-image: none;
    };
  }

  .grove-hero-callout {
    background-color: var(--grove-base-100);
    @media (min-width: 40rem) {
      border-right: 0.5px solid var(--grove-base-700);
      max-width: var(--grove-hero-callout-width);
    }
  }

  .grove-hero-h1 {
    @media (min-width: 40rem) {
      font-size: 3.5rem;
    };
  }
  
  .grove-hero-primary-color {
    color: var(--grove-primary-700);
  }

  .grove-hero_image {
    @media (min-width: 40rem) {
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: var(--grove-hero-callout-width);
      right: calc((100% - 100vw) / 2);
    }
    img {
      object-fit: cover;
    }
  }
</style>
