---
import FigmaStorybookButtonGroup from '../components/FigmaStorybookButtonGroup.astro';
interface Props {
  name: string;
  category?: 'COMPONENTS' | 'STYLES' | 'PATTERNS' | 'TEMPLATES'
  description?: string;
  figmaUrl?: string;
  storybookUrl?: string;
  wcagBadge?: boolean;
}

const { name, category, description, figmaUrl, storybookUrl, wcagBadge = true } = Astro.props;
---
<section>
    <div class="padding-top-6 padding-bottom-205 tablet:display-flex">
        <div class="flex-fill tablet:margin-right-2">
            <header>
                {category && (<span class="font-body-xs text-base">{category}</span>)}
                <h1 class="margin-0">{name}</h1>
                <p>{description}</p>
            </header>
            {wcagBadge && (
                <div class="width-fit-content">
                    <span class="padding-1 text-white wcag-badge">WCAG 2.1 AA</span>
                </div>
            )}
        </div>
        <div class="display-flex flex-align-start">
            <FigmaStorybookButtonGroup figmaUrl={figmaUrl} storybookUrl={storybookUrl}/>
        </div>
    </div>
</section>

<style>
    .wcag-badge {
        background-color: var(--grove-primary-600);
    } 
</style> 