---
import facebook from '../assets/facebook.svg';
import github from '../assets/github.svg'
import instagram from '../assets/instagram.svg';
import linkedin from '../assets/linkedin.svg';
import njialogo from '../assets/njia-logo.svg'
import njlogo from '../assets/nj-logo.png'
import x from '../assets/x.svg';
---


<footer class="usa-footer">
  <feedback-widget class="grove-feedback-widget" contact-link="mailto:team@innovation.nj.gov" />
  <div class="grove-footer-base-xlight-bg">
    <div class="grid-container usa-footer__return-to-top">
      <a href="#">Return to top</a>
    </div>
  </div>
  <div class="usa-footer__primary-section grove-footer-base-light-bg">
    <nav class="usa-footer__nav" aria-label="footer">
      <ul class="grid-row text-ink grove-footer-nav">
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/guides/gettingstarted/">Getting Started</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content margin-top-0">
          <a class="usa-footer__primary-link" href="/content/overview">Content</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content margin-top-0">
          <a class="usa-footer__primary-link" href="/styles/typography/">Styles</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content margin-top-0">
          <a class="usa-footer__primary-link" href="/reference/accordion/">Components</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="usa-footer__secondary-section grove-footer-base-bg">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-1 flex-align-start">
          <div class="mobile-lg:grid-col-auto mobile-lg:margin-top-05">
            <img class="usa-footer__logo-img height-4 width-4" src={njialogo.src} alt="New Jersey Innovation Authority logo: blue rounded hexagon and yellow diagonal stripe" />
          </div>
          <div class="mobile-lg:grid-col-auto">
            <h3 class="usa-footer__logo-heading margin-bottom-2">New Jersey Innovation Authority</h3>
            <address class="usa-footer__address">
              State of New Jersey
              <br/>
              P.O. Box 211
              <br/>
              Trenton, New Jersey 08625-0211
            </address>
            <p>
              <a href="mailto:team@innovation.nj.gov">team@innovation.nj.gov</a>
              <br />
              <a class="text-base" rel="noopener noopener noreferrer" href="https://innovation.nj.gov/tos/">Privacy, Terms &amp; License</a>
            </p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <div class="usa-footer__social-links grid-row grid-gap-1">
            <div class="grid-col-auto">
              <a class="usa-social-link" rel="noopener noopener noreferrer" target="_blank" href="https://github.com/newjersey">
                <img class="usa-social-link__icon" src={github.src} alt="GitHub"/>
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" rel="noopener noopener noreferrer" target="_blank" href="https://www.facebook.com/NJGov/">
                <img class="usa-social-link__icon" src={facebook.src}  alt="Facebook"/>
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" rel="noopener noopener noreferrer" target="_blank" href="https://x.com/njgov">
                <img class="usa-social-link__icon" src={x.src} alt="X, formerly Twitter"/>
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link usa-social-link--linkedin" rel="noopener noopener noreferrer" target="_blank" href="https://www.linkedin.com/company/state-of-new-jersey/">
                <img class="usa-social-link__icon" src={linkedin.src} alt="Linkedin"/>
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" rel="noopener noopener noreferrer" target="_blank" href="https://www.instagram.com/njgov/">
                <img class="usa-social-link__icon" src={instagram.src} alt="Instagram"/>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
<div class="usa-identifier grove-footer-primary-bg margin-top-0">
<section class="usa-identifier__section usa-identifier__section--masthead" aria-label="Agency identifier">
    <div class="usa-identifier__container">
    <div class="usa-identifier__logos">
        <a href="https://nj.gov" class="usa-identifier__logo" target="_blank" rel="noopener noreferrer">
        <img class="usa-identifier__logo-img" src={njlogo.src} alt="State of New Jersey logo: letter N with J made by shape of state" role="img"/>
        </a>
    </div>
    <div class="usa-identifier__identity" aria-label="Agency description">
        <p class="usa-identifier__identity-disclaimer">
        An official website of <a href="https://nj.gov" target="_blank" rel="noopener noreferrer">the State of New Jersey</a>
        </p>
    </div>
    </div>
</section>
<nav class="usa-identifier__section usa-identifier__section--required-links" aria-label="Important links">
    <div class="usa-identifier__container">
    <ul class="usa-identifier__required-links-list">
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/governor/admin/about/" class="usa-identifier__required-link" target="_blank" rel="noopener noreferrer">
            Governor Mikie Sherrill
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/governor/admin/lt/" class="usa-identifier__required-link" target="_blank" rel="noopener noreferrer">
            Lt. Governor Dr. Dale G. Caldwell
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            NJ Home
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/nj/gov/njgov/alphaserv.html" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Services A to Z
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/nj/gov/deptserv/" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Departments/Agencies
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/faqs/" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            FAQs
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/nj/feedback.html" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Contact Us
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/nj/privacy.html" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Privacy Notice
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/nj/legal.html" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Legal Statement &amp; Disclaimers
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/nj/accessibility.html" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Accessibility
        </a>
        </li>
        <li class="usa-identifier__required-links-item">
        <a href="https://nj.gov/opra/" class="usa-identifier__required-link usa-link" target="_blank" rel="noopener noreferrer">
            Open Public Records Act (OPRA)
        </a>
        </li>
    </ul>
    </div>
</nav>
<section class="usa-identifier__section usa-identifier__section--usagov" aria-label="U.S. government information and services">
    <div class="usa-identifier__container">
    <div class="usa-identifier__usagov-description">
        Copyright © 2026 State of New Jersey
    </div>
    </div>
</section>
</div>


<style>
    .grove-footer-nav {
      @media (min-width: 30rem) {
        /* deconstructed USWDS grid-gap */
        margin-left: -1rem;
        margin-right: -1rem;
        > * {
          padding-left: 1rem;
          padding-right: 1rem;
        }
      };
    }
    .grove-footer-base-xlight-bg {
        background-color: var(--grove-base-100);
    }
    .grove-footer-base-light-bg {
        background-color: var(--grove-base-200);
    }
    .grove-footer-base-bg {
        background-color: var(--grove-base-400);
    }
    .grove-footer-primary-bg {
        background-color: var(--grove-primary-700);
    }
    :global(.grove-feedback-widget) {
      .feedback-container {
        background-color: var(--grove-gray-cool-5);
        padding-inline: 1.5rem;
        padding-block: 1rem;
      }
      .feedback-button-group {
        flex-wrap: nowrap;
      }
    }
</style>

<script>
  import "@newjersey/feedback-widget/feedback-widget.min.js";
</script>
