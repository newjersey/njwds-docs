{
  // Current version of the configuration format (always 0.2)
  "version": "0.2",
  
  // The primary locale for spellchecking
  "language": "en",
  
  // Words that are allowed in this project (case-insensitive by default)
  "words": [],
  
  // Specific words to bypass, even if they match forbidden or custom rules
  "ignoreWords": [],
  
  // Files, folders, and patterns that CSpell should entirely ignore
  "ignorePaths": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "coverage/**",
    "*.min.js",
    ".cspell.json"
  ],
  
  // Activates specific pre-installed dictionaries
  "dictionaries": [
    "typescript",
    "node",
    "npm",
    "filetypes",
    "html",
    "css",
    "bash",
    "fonts",
    "project-words"
  ],

  // Defines the custom "project-words" dictionary used above
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],

  // Configures overrides or adjustments for specific programming languages
  "languageSettings": [
    {
      "languageId": "javascript",
      "allowCompoundWords": true,
      "dictionaries": [
        "typescript",
        "html"
      ]
    }
  ],

  "overrides": [
    {
      "filename": "**/*.{mdx,astro}",
      "languageId": "typescript",
      "allowCompoundWords": true
    }
  ],

  // Advanced: Ignore blocks of text matching specific regex patterns (e.g., UUIDs or URLs)
  "ignoreRegExpList": [
    "/[a-f0-9]{32}/i",
    "/%[0-9A-Fa-f]{2}/g"
  ]
}
